{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "问题分类",
  "type": "object",
  "required": [
    "domain",
    "sample_id",
    "categories"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "title"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
