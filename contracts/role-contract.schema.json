{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "角色契约",
  "type": "object",
  "required": [
    "domain",
    "sample_id",
    "roles"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "title",
          "covers"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "data_purpose",
                "permission_trigger",
                "disclosure_text",
                "third_party_component",
                "deletion_path"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
