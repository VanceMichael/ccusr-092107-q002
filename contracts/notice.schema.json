{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "监管通报",
  "type": "object",
  "required": [
    "domain",
    "sample_id",
    "notice_date",
    "term_workdays",
    "apps"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "notice_date": {
      "type": "string",
      "format": "date"
    },
    "term_workdays": {
      "type": "integer",
      "minimum": 1
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "app_id",
          "name",
          "platform",
          "channel",
          "version",
          "problem"
        ],
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "app",
              "mini_program"
            ]
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
