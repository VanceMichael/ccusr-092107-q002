{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "角色契约",
  "type": "object",
  "required": [
    "version",
    "roles"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "conclusion_scope"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "conclusion_scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
