{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "版本台账",
  "type": "object",
  "required": [
    "domain",
    "sample_id",
    "slots"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "app_id",
          "version",
          "channel",
          "stage",
          "online_from"
        ],
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "enum": [
              "gray",
              "full"
            ]
          },
          "online_from": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
