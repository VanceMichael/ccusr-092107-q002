{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工作日历",
  "type": "object",
  "required": [
    "domain",
    "sample_id",
    "holidays"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "holidays": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "date"
      }
    }
  },
  "additionalProperties": false
}
